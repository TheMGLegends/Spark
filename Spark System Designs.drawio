        <mxCell id="eKk8V9CFJGvcSFXkHoSS-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;Terminal Owner set in Awake by GetComponentInParent or using a dedicated Initialise Method that the ElectricalDevice has to call&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="-200" y="240" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Per instance Connected/Disconnected events (NOT STATIC), passing itself as the param so we know what wire changed without having to have a ref&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="630" y="118" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Connected event raised from &quot;not fully connected&quot; to &quot;both ends connected&quot; only&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="780" y="300" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Disconnected event raised from &quot;Both ends connected&quot; to &quot;not fully connected&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="770" y="385" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;This means when a player is dragging and wire is ony attached at one end, nothing is raised&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="920" y="339" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Helper IsFullyConnected collapsed into private func/accessors, so we know when to raise connected/disconnected events&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="780" y="500" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Cleanup called in OnDestroy, needs to disconnect itself from its terminals so there aren&#39;t any stale refs&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="780" y="608" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Prefab variants of wire will have different colours and the wireType will be settable only via inspector like TerminalType&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="130" x="870" y="174" as="geometry" />
        </mxCell>
        <mxCell id="eKk8V9CFJGvcSFXkHoSS-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;Default empty function for PowerOn/PowerOff, for electrical devices that do not need it e.g. (Battery)&lt;/font&gt;" vertex="1">
          <mxGeometry height="66" width="130" x="-150" y="880" as="geometry" />
        </mxCell>
